Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /PointCloud21
        - /Image1
        - /Image2
        - /Image3
        - /Image4
      Splitter Ratio: 0.5
    Tree Height: 489
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane Cell Count: 10
      Plane: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: RGB8
      Decimation: 1
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Fused PointCloud
      Position Transformer: XYZ
      Queue Size: 120
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.01
      Style: Points
      Topic: /fused_pointcloud
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.8
      Class: rviz/Image
      Enabled: true
      Name: Image1
      Image Topic: /m_gmsl_1/image_raw
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Alpha: 0.8
      Class: rviz/Image
      Enabled: true
      Name: Image2
      Image Topic: /m_gmsl_2/image_raw
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Alpha: 0.8
      Class: rviz/Image
      Enabled: true
      Name: Image3
      Image Topic: /m_gmsl_3/image_raw
      Transport Hint: raw
      Unreliable: false
      Value: true
    - Alpha: 0.8
      Class: rviz/Image
      Enabled: true
      Name: Image4
      Image Topic: /m_gmsl_4/image_raw
      Transport Hint: raw
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: base_link
      Value: Orbit (rviz)
      Yaw: 0.5
    Saved: ~